8544-370332703_large.mp4","kind":"video","author":"wowfactorfilms (Pixabay)"},"presentationOnly":false},{"text":"Your renewal still needs its own comparison.","query":"renewal paperwork American driver","subject":"renewal paperwork","visual":{"type":"title","headline":"COMPARE YOUR RENEWAL","sub":"Your renewal still needs its own comparison.","color":"dark"},"clips":[{"url":"https://images.unsplash.com/photo-1555215695-3004980ad54e?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MTB8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"Jon Koop (Unsplash)"},{"url":"https://cdn.pixabay.com/video/2016/01/31/2030-153703078_large.mp4","kind":"video","author":"VariousPhotography (Pixabay)"}],"clip":{"url":"https://images.unsplash.com/photo-1555215695-3004980ad54e?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MTB8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"Jon Koop (Unsplash)"},"presentationOnly":false},{"text":"Before we continue, what's your opinion? Did your car insurance renewal fall?","query":"driver American reading bill","subject":"driver","visual":{"type":"poll","headline":"DID YOUR CAR INSURANCE RENEWAL FALL?","items":["Yes","No"],"sub":"What do you think? Comment below."},"clips":[{"url":"https://cdn.pixabay.com/video/2022/10/05/133698-757782420_large.mp4","kind":"video","author":"blackmarketmusic (Pixabay)"}],"clip":{"url":"https://cdn.pixabay.com/video/2022/10/05/133698-757782420_large.mp4","kind":"video","author":"blackmarketmusic (Pixabay)"},"presentationOnly":false},{"text":"Share your experience. Satisfaction scores aren't your bill. Next, consider usage-based insurance.","query":"motorist American policy review","subject":"motorist","visual":{"type":"title","headline":"MOTORIST","color":"dark","sub":"Share your experience."},"clips":[{"url":"https://cdn.pixabay.com/video/2022/10/10/134312-759212642_large.mp4","kind":"video","author":"KM007_ (Pixabay)"}],"clip":{"url":"https://cdn.pixabay.com/video/2022/10/10/134312-759212642_large.mp4","kind":"video","author":"KM007_ (Pixabay)"},"presentationOnly":false},{"text":"Nationwide led usage-based insurance satisfaction with 711 points out of 1,000 in the same 2026 study.","query":"Nationwide American insurance office","subject":"nationwide","visual":{"type":"stat","headline":"USAGE-BASED SATISFACTION LEADER","sub":"Satisfaction points • Nationwide • 2026","value":"711/1,000","color":"green"},"clips":[{"url":"https://pixabay.com/get/gc46485c5e020b32c63bd98b5c64123e3cbc2987a40fb66fe82403dfa90bb1e3a54f8c0a2e52e9cb5cdc658b4416aca5453ed4691108314b777a630ca181eaf2c_1280.jpg","kind":"photo","author":"tookapic (Pixabay)"}],"clip":{"url":"https://pixabay.com/get/gc46485c5e020b32c63bd98b5c64123e3cbc2987a40fb66fe82403dfa90bb1e3a54f8c0a2e52e9cb5cdc658b4416aca5453ed4691108314b777a630ca181eaf2c_1280.jpg","kind":"photo","author":"tookapic (Pixabay)"},"presentationOnly":false},{"text":"That's a separate category, not a score to slip into our regional countdown.","query":"Nationwide agent American office","subject":"nationwide agent","visual":{"type":"title","headline":"A SEPARATE CATEGORY","sub":"Usage-based insurance satisfaction","color":"dark"},"clips":[{"url":"https://images.unsplash.com/photo-1599599054812-1fee22d625e1?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MjB8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"Stephan Louis (Unsplash)"}],"clip":{"url":"https://images.unsplash.com/photo-1599599054812-1fee22d625e1?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MjB8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"Stephan Louis (Unsplash)"},"presentationOnly":false},{"text":"When comparing quotes, keep your liability limits and deductibles the same.","query":"quote documents American insurance","subject":"quote documents","visual":{"type":"list","headline":"COMPARE MATCHING COVERAGE","color":"dark","items":["Same liability limits","Same deductibles"]},"clips":[{"url":"https://images.unsplash.com/photo-1577977799980-cd7053d89661?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MTl8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"aranprime (Unsplash)"}],"clip":{"url":"https://images.unsplash.com/photo-1577977799980-cd7053d89661?ixid=M3wxMDkyNjk3fDB8MXxzZWFyY2h8MTl8fGRyaXZpbmd8ZW58MXx8fHwxNzkxMzQxNTg3fDA&ixlib=rb-4.1.0&w=2400&fit=max&q=85","kind":"photo","author":"aranprime (Unsplash)"},"presentationOnly":false},{"text":"Otherwise, a cheaper bill might simply mean you're accepting more costs after a crash.","query":"damaged car American inspection","subject":"damaged car","visual":{"type":"title","headline":"LOOK BEYOND THE BILL","color":"green"},"clips":[{"url":"https://pixabay.com/get/g09f80bd2755193b9627a358ce085d818bf6c36fbf21e961bc2510adcca610ee9dcf5ea6669e08eff0b864091c26da7899a0a1aef48a49fafab71ad39e194f574_1280.jpg","kind":"photo","author":"Pexels (Pixabay)"}],"clip":{"url":"https://pixabay.com/get/g09f80bd2755193b9627a358ce085d818bf6c36fbf21e961bc2510adcca610ee9dcf5ea6669e08eff0b864091c26da7899a0a1aef48a49fafab71ad39e194f574_1280.jpg","kind":"photo","author":"Pexels (Pixabay)"},"presentationOnly":false},{"text":"Consider your regional satisfaction leader, then compare quotes with matching coverage. Your actual premium matters more than a survey ranking.","query":"car owner American consultation","subject":"car owner","visual":{"type":"title","headline":"CAR OWNER","color":"dark","sub":"Your actual premium matters more than a survey ranking."},"clips":[{"url":"https://pixabay.com/get/g28d00b0c06ff23d0a117fe7b979262eb353dd29eca39bbfcf47f0251fb451761d2a5d06db8a64a819447c19b033a182b67799197e8ffefb025da0d6d52ce323c_1280.jpg","kind":"photo","author":"Sponchia (Pixabay)"},{"url":"https://pixabay.com/get/g5120f0696f7d77ef7f4c51619ca7a9ee1c912bfadc079cb0a16a46f43b705e52c2f436e1b5489e1b69df84f9ec8d4525b739488dcb9aec11090f92cfa188f797_1280.jpg","kind":"photo","a