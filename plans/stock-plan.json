d305b7b63fe8901d04e43184e5233fa920d1adcda9_1280.jpg","kind":"photo","author":"Engin_Akyurt (Pixabay)"}],"presentationOnly":false},{"text":"But your posted price also reflects wholesale fuel costs, delivery expenses and station pricing.","query":"gas station American forecourt","subject":"gas station","visual":{"type":"list","headline":"What shapes the pump price","color":"dark","items":["Wholesale fuel costs","Delivery expenses","Station pricing"]},"clip":{"url":"https://pixabay.com/get/g7765a9a9a906f2187db3f41b7aaf59a10c1dc1fba01c27ceb48cb99dc4e9b4ac33f53af4ca09bd2f75997af22509dbb96af0e1885e24f5092925937c636091ad_1280.jpg","kind":"photo","author":"RoumanetD (Pixabay)"},"clips":[{"url":"https://pixabay.com/get/g7765a9a9a906f2187db3f41b7aaf59a10c1dc1fba01c27ceb48cb99dc4e9b4ac33f53af4ca09bd2f75997af22509dbb96af0e1885e24f5092925937c636091ad_1280.jpg","kind":"photo","author":"RoumanetD (Pixabay)"}],"presentationOnly":false},{"text":"Those costs can move while the tax break takes effect, complicating a simple before-and-after comparison.","query":"fuel tanker American delivery","subject":"fuel tanker","visual":{"type":"title","headline":"Other costs keep moving","color":"blue"},"clip":{"url":"https://cdn.pixabay.com/video/2021/03/09/67364-522626695_large.mp4","kind":"video","author":"ChristianBodhi (Pixabay)"},"clips":[{"url":"https://cdn.pixabay.com/video/2021/03/09/67364-522626695_large.mp4","kind":"video","author":"ChristianBodhi (Pixabay)"}],"presentationOnly":false},{"text":"Compare the same gasoline grade, at the same station, using the same payment method.","query":"octane buttons American pump","subject":"octane buttons","visual":{"type":"list","headline":"Keep your comparison consistent","color":"dark","items":["Same gasoline grade","Same station","Same payment method"]},"clip":{"url":"https://pixabay.com/get/gc384342da6271a7733b9ae28e289b5cab8361b730fe58bd08e07df8d3bc367ccc930b9dead2bbce72e4f6b4ffccab1ff166860b3249350e6840f25341ff0157f_1280.jpg","kind":"photo",